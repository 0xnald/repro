PORT=8787
ARTIFACT_DIR=./artifacts
PUBLIC_BASE_URL=https://repro-asp.up.railway.app

# free | x402. Use x402 for the OKX.AI paid listing.
PAYMENT_MODE=x402
# x402 mode returns completed reports inline, so the worker defaults off.
# Set true only for async local/dashboard runs with an isolated dev queue.
REPRO_START_WORKER=false
# Exact repeated paid requests can reuse fresh real evidence to stay inside OKX replay timeouts.
REPRO_SYNC_CACHE_TTL_SECONDS=86400

# Required when PAYMENT_MODE=x402.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
PAY_TO_ADDRESS=0xb6fE13c656087406a78Fb62D6d2948A5724Ac2A6
REPRO_PRICE=$0.001

X402_RESOURCE_URL=https://repro-asp.up.railway.app/v1/reproduce
X402_RESOURCE_DESCRIPTION=Repro verified bug reproduction package
X402_NETWORK=eip155:196
X402_MAX_TIMEOUT_SECONDS=300

# Optional OKX facilitator overrides.
OKX_FACILITATOR_URL=
OKX_SYNC_SETTLE=false
X402_SYNC_ON_START=true

# Required reasoning engine. Repro does not use static fallback reasoning.
REPRO_REASONING_REQUIRED=true
REPRO_ALLOW_STATIC_FALLBACK=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://repro-asp.up.railway.app
OPENROUTER_APP_NAME=Repro
REPRO_PLANNER_MODEL=anthropic/claude-sonnet-4
REPRO_REPORT_MODEL=anthropic/claude-sonnet-4
REPRO_TEST_MODEL=openai/gpt-4.1-mini
REPRO_VISION_MODEL=google/gemini-2.5-flash
REPRO_VISION_ENABLED=true
REPRO_REASONING_TIMEOUT_MS=45000

# Production job system and persistence.
DATABASE_URL=
REDIS_URL=
REPRO_QUEUE_KEY=repro:jobs:production-v1
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_REGION=auto

# Safety controls.
REPRO_MAX_ACTIONS=12
MAX_SCAN_SECONDS=120
ARTIFACT_RETENTION_DAYS=14
REPRO_ALLOW_FORM_SUBMIT=false
REPRO_ALLOW_EXTERNAL_NAVIGATION=false
REPRO_ALLOW_DOWNLOADS=false
REPRO_ALLOW_DESTRUCTIVE_ACTIONS=false
REPRO_RECORD_VIDEO=false
REPRO_FULL_PAGE_SCREENSHOTS=false

# Optional Railway presence worker. Deploy as a second Railway service with:
# REPRO_PROCESS=presence
REPRO_PROCESS=api
OKX_PRESENCE_CHAIN_INDEX=196
OKX_PRESENCE_INTERVAL_MS=120000
ONCHAINOS_BIN=onchainos
